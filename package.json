    "test:anonymity": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs --conditions=react-server scripts/test-anonymity.mts",
    "gen:code": "node scripts/gen-access-code.mjs",
    "test:gate": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/test-gate.mts",
    "test:submission": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/test-submission.mts"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
