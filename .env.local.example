# SoF Voice — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored (.gitignore line 34: .env*).
# NEVER commit real values. NEVER prefix any of these with NEXT_PUBLIC_.

# --- Supabase: Project Settings -> API ---------------------------------------
# "Project URL". Looks like https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The PUBLISHABLE / ANON key. Safe in a browser, but we don't send it there.
# Needed only so the anonymity test can PROVE the anon role has zero access.
# New projects: starts with  sb_publishable_
# Older projects: a long JWT under "anon public"
SUPABASE_ANON_KEY=

# The SECRET / SERVICE_ROLE key. Bypasses ALL row-level security.
# This is the most sensitive value in the project. Server-side only, forever.
# New projects: starts with  sb_secret_
# Older projects: a long JWT under "service_role" (must click "Reveal")
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: Project Settings -> Database -> Connection string -> URI -------
# Used to run migrations and to introspect information_schema in the test gate.
# Replace [YOUR-PASSWORD] with the DB password you set when creating the project.
# Use the Session pooler URI (port 5432) if your network blocks direct IPv6.
DATABASE_URL=

# --- Access codes (invariant 7: compared server-side only, never sent to client)
# Leave these for now; slice 2 generates strong values. Do not use the PDF's
# SOF-VOICE-2026 / CHAIR-2026 — they were published in a document.
MEMBER_ACCESS_CODE=
ADMIN_ACCESS_CODE=
