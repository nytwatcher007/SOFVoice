# SoF Voice — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored (.gitignore line 34: .env*).
# NEVER commit real values. NEVER prefix any of these with NEXT_PUBLIC_.

# --- Supabase: Project Settings -> API ---------------------------------------
# "Project URL". Looks like https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The PUBLISHABLE / ANON key. Safe in a browser, but we don't send it there.
# Needed only so the anonymity test can PROVE the anon role has zero access.
# New projects: starts with  sb_publishable_
# Older projects: a long JWT under "anon public"
SUPABASE_ANON_KEY=

# The SECRET / SERVICE_ROLE key. Bypasses ALL row-level security.
# This is the most sensitive value in the project. Server-side only, forever.
# New projects: starts with  sb_secret_
# Older projects: a long JWT under "service_role" (must click "Reveal")
SUPABASE_SERVICE_ROLE_KEY=

# --- Database: TWO connection strings, deliberately ---------------------------
#
# Use the Supabase **Session pooler** URI (port 5432, user <role>.<project-ref>).
# The direct host db.<ref>.supabase.co is IPv6-only and unreachable from many
# networks — if the database suddenly stops resolving, check this first.

# The APPLICATION role. This is the only one the deployed app ever sees.
# No BYPASSRLS, no CREATEROLE, no DDL, no DELETE, no TRUNCATE. A leaked copy of
# this credential cannot erase submissions, reshape the schema, or escalate.
# Generate with:  npm run db:app-role
DATABASE_URL=

# PRIVILEGED (the postgres role). Migrations, test suites and admin scripts.
#
# This must NOT be set in the Vercel production environment. The deployed app
# should have no route to the privileged role at all — that is the whole point
# of splitting them. Test suites need it because they assume the `anon` role and
# introspect information_schema, neither of which sof_app can do, and that
# inability is itself a property worth having.
DATABASE_ADMIN_URL=

# --- Access gate (invariant 7: compared server-side only, never sent to client)
# Generate both with:  npm run gen:code
#
# The one code shared by students and faculty. ~60 bits of entropy, which is
# what makes brute force infeasible without a rate limiter. If you shorten it
# for convenience, you need a limiter.
# Do NOT use the PDF's SOF-VOICE-2026 — it was published in a document.
MEMBER_ACCESS_CODE=

# HMAC key for signing the session cookie. Rotating this signs every member out
# immediately — that is the emergency lever if the access code leaks mid-term.
SESSION_SECRET=

# NOTE: there is deliberately no ADMIN_ACCESS_CODE. CLAUDE.md lines 78-88 give
# admins real Supabase Auth accounts (email + password + MFA), because admin
# actions must be attributable while submitters must have no identity at all.
# Do not add a shared admin code.
